<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="图像设置"
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <!-- 亮度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">
        <TextView
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="亮度"
            android:textSize="14sp"
            android:textColor="@android:color/black" />
        <EditText
            android:id="@+id/et_brightness"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="numberDecimal|numberSigned"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:background="@android:color/transparent"
            android:hint="0" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(-255~255)"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:paddingLeft="4dp" />
    </LinearLayout>

    <!-- 对比度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">
        <TextView
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="对比度"
            android:textSize="14sp"
            android:textColor="@android:color/black" />
        <EditText
            android:id="@+id/et_contrast"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="numberDecimal"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:background="@android:color/transparent"
            android:hint="1.0" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(0.1~3.0)"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:paddingLeft="4dp" />
    </LinearLayout>

    <!-- 饱和度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">
        <TextView
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="饱和度"
            android:textSize="14sp"
            android:textColor="@android:color/black" />
        <EditText
            android:id="@+id/et_saturation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="numberDecimal"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:background="@android:color/transparent"
            android:hint="1.0" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(0.0~2.0)"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:paddingLeft="4dp" />
    </LinearLayout>

    <!-- CLAHE 强度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">
        <TextView
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="CLAHE"
            android:textSize="14sp"
            android:textColor="@android:color/black" />
        <EditText
            android:id="@+id/et_clip_limit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="numberDecimal"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:background="@android:color/transparent"
            android:hint="3.0" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(2.0~5.0)"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:paddingLeft="4dp" />
    </LinearLayout>

    <!-- 锐化强度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">
        <TextView
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="锐化"
            android:textSize="14sp"
            android:textColor="@android:color/black" />
        <EditText
            android:id="@+id/et_sharpen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="numberDecimal"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:background="@android:color/transparent"
            android:hint="0.5" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(0.0~1.0)"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:paddingLeft="4dp" />
    </LinearLayout>

    <!-- 按钮行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:paddingTop="12dp">
        <Button
            android:id="@+id/btn_reset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="还原"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            android:stateListAnimator="@null" />
        <Button
            android:id="@+id/btn_ok"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="确定"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            android:stateListAnimator="@null" />
        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="取消"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>